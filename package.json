{
  "name": "dsh-signal",
  "version": "0.6.12",
  "description": "Tidal DSH branding, verified multi-provider resources, filterable local analytics, and local provider identity overrides.",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/Ricardo-WJP/dsh-signal.git" },
  "homepage": "https://github.com/Ricardo-WJP/dsh-signal#readme",
  "bugs": { "url": "https://github.com/Ricardo-WJP/dsh-signal/issues" },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "DSH Signal",
    "summary": "点阵品牌区、费用额度检测、工作说明面板与本地 Token 用量。",
    "categories": [
      "Web UI",
      "观测"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:signal-resource"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2",
      "node": ">=22"
    },
    "permissions": {
      "network": [
        "https://api.deepseek.com",
        "https://opencode.ai",
        "https://openrouter.ai",
        "https://api.moonshot.ai",
        "https://api.moonshot.cn",
        "https://api.siliconflow.cn",
        "https://api.siliconflow.com"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:client": "node tools/build-client.mjs",
    "verify:client": "node tools/verify-client-build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/typert.host.js && node --check lib/client.js && npm run verify:client && npm test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.8",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.8 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "motion",
    "usage"
  ],
  "license": "MIT"
}
